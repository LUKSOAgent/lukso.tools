{
  "version": "1.0",
  "retrieval": {
    "mandatory_search": true,
    "search_before_answer": true,
    "sources": ["memory/*.md", "MEMORY.md"],
    "min_results": 3
  },
  "consolidation": {
    "daily_logs_to_memory": true,
    "weekly_review": true,
    "archive_after_days": 30
  },
  "projects": {
    "tracker_file": "memory/projects.md",
    "auto_update": true
  },
  "hindsight": {
    "verify_multiple_sources": true,
    "check_credentials": true,
    "admit_uncertainty": true
  }
}