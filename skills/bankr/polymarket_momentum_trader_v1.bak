#!/usr/bin/env python3
"""
Bankr Polymarket Momentum Trader
Trades BTC prediction markets on Polymarket via Bankr when momentum is strong.
"""

import os
import sys
import json
import time
import subprocess
import requests
from datetime import datetime, timezone
from collections import deque

# Configuration
CONFIG = {
    "min_momentum_pct": 0.15,  # Minimum 0.15% momentum
    "confidence_threshold": 0.65,
    "trade_amount": 10,  # $10 per trade
    "check_interval": 30,  # seconds
    "cooldown": 300,  # 5 minutes between trades
    "network": "polygon",  # Use Polygon for lowest fees
}

# Price history for momentum calculation
price_history = deque(maxlen=100)
last_trade_time = 0


def get_btc_price():
    """Get current BTC price from Coinbase or Binance."""
    try:
        # Try Coinbase first
        resp = requests.get("https://api.coinbase.com/v2/exchange-rates?currency=BTC", timeout=5)
        data = resp.json()
        price = float(data['data']['rates']['USDT'])
        return price
    except:
        pass
    
    try:
        # Fallback to Binance
        resp = requests.get("https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT", timeout=5)
        data = resp.json()
        price = float(data['price'])
        return price
    except:
        return None


def calculate_momentum():
    """Calculate momentum across multiple timeframes."""
    global price_history
    
    if len(price_history) < 10:
        return None
    
    now = time.time()
    
    # Get prices for different timeframes
    prices_2m = [p['price'] for p in price_history if now - p['time'] <= 120]
    prices_5m = [p['price'] for p in price_history if now - p['time'] <= 300]
    prices_10m = [p['price'] for p in price_history if now - p['time'] <= 600]
    
    if len(prices_2m) < 2 or len(prices_5m) < 2:
        return None
    
    # Calculate momentum percentages
    mom_2m = ((prices_2m[-1] - prices_2m[0]) / prices_2m[0]) * 100 if prices_2m[0] > 0 else 0
    mom_5m = ((prices_5m[-1] - prices_5m[0]) / prices_5m[0]) * 100 if len(prices_5m) >= 2 and prices_5m[0] > 0 else 0
    mom_10m = ((prices_10m[-1] - prices_10m[0]) / prices_10m[0]) * 100 if len(prices_10m) >= 2 and prices_10m[0] > 0 else 0
    
    return {
        'price_now': prices_2m[-1],
        'mom_2m': mom_2m,
        'mom_5m': mom_5m,
        'mom_10m': mom_10m,
    }


def generate_signal(momentum_data):
    """Generate trading signal based on multi-timeframe momentum."""
    if not momentum_data:
        return None, 0, "No momentum data"
    
    mom_2m = momentum_data['mom_2m']
    mom_5m = momentum_data['mom_5m']
    mom_10m = momentum_data['mom_10m']
    
    min_mom = CONFIG['min_momentum_pct']
    
    up_score = 0
    down_score = 0
    
    # 2m momentum (weight: 30%)
    if mom_2m > min_mom:
        up_score += 0.30
    elif mom_2m < -min_mom:
        down_score += 0.30
    
    # 5m momentum (weight: 35%)
    if mom_5m > min_mom:
        up_score += 0.35
    elif mom_5m < -min_mom:
        down_score += 0.35
    
    # 10m momentum (weight: 35%)
    if mom_10m > min_mom:
        up_score += 0.35
    elif mom_10m < -min_mom:
        down_score += 0.35
    
    # Determine signal
    if up_score > down_score and up_score >= 0.65:
        return "UP", up_score, f"UP: 2m={mom_2m:+.2f}%, 5m={mom_5m:+.2f}%, 10m={mom_10m:+.2f}%"
    elif down_score > up_score and down_score >= 0.65:
        return "DOWN", down_score, f"DOWN: 2m={mom_2m:+.2f}%, 5m={mom_5m:+.2f}%, 10m={mom_10m:+.2f}%"
    
    return None, 0, f"No consensus: UP={up_score:.2f}, DOWN={down_score:.2f}"


def place_bet_with_bankr(direction, amount):
    """Place a bet on Polymarket using Bankr."""
    side = "Yes" if direction == "UP" else "No"
    
    prompt = f"Bet ${amount} on {side} for Bitcoin Up or Down on Polymarket using {CONFIG['network']}"
    
    # Run bankr command
    skill_dir = "/root/.openclaw/workspace/skills/bankr"
    try:
        result = subprocess.run(
            ["./bankr.sh", prompt],
            cwd=skill_dir,
            capture_output=True,
            text=True,
            timeout=300  # 5 minutes timeout (Bankr can be slow)
        )
        return result.returncode == 0, result.stdout + result.stderr
    except subprocess.TimeoutExpired:
        return False, "Bankr API timeout (300s)"
    except Exception as e:
        return False, f"Error: {str(e)}"


def main():
    """Main trading loop."""
    global price_history, last_trade_time
    
    print("=" * 60)
    print("🚀 Bankr Polymarket Momentum Trader")
    print("=" * 60)
    print(f"Network: {CONFIG['network'].upper()}")
    print(f"Trade Amount: ${CONFIG['trade_amount']}")
    print(f"Min Momentum: {CONFIG['min_momentum_pct']}%")
    print(f"Check Interval: {CONFIG['check_interval']}s")
    print("=" * 60)
    print()
    
    cycle = 0
    
    while True:
        cycle += 1
        now = datetime.now(timezone.utc)
        
        print(f"\n{'='*60}")
        print(f"Cycle #{cycle} - {now.strftime('%H:%M:%S UTC')}")
        print('='*60)
        
        # Get current BTC price
        price = get_btc_price()
        if not price:
            print("❌ Failed to get BTC price, retrying...")
            time.sleep(5)
            continue
        
        # Store price
        price_history.append({'price': price, 'time': time.time()})
        print(f"📊 BTC: ${price:,.2f} | History: {len(price_history)} points")
        
        # Need minimum history
        if len(price_history) < 10:
            print(f"⏳ Building price history ({len(price_history)}/10)...")
            time.sleep(CONFIG['check_interval'])
            continue
        
        # Check cooldown
        if time.time() - last_trade_time < CONFIG['cooldown']:
            remaining = CONFIG['cooldown'] - (time.time() - last_trade_time)
            print(f"⏳ Cooldown active ({remaining:.0f}s remaining)")
            time.sleep(CONFIG['check_interval'])
            continue
        
        # Calculate momentum
        momentum = calculate_momentum()
        if not momentum:
            print("⏳ Insufficient data for momentum calculation")
            time.sleep(CONFIG['check_interval'])
            continue
        
        # Generate signal
        signal, confidence, reason = generate_signal(momentum)
        
        print(f"📈 Momentum: 2m={momentum['mom_2m']:+.3f}% | 5m={momentum['mom_5m']:+.3f}% | 10m={momentum['mom_10m']:+.3f}%")
        print(f"🎯 Signal: {signal if signal else 'NONE'} | Confidence: {confidence:.2f}")
        print(f"📝 {reason}")
        
        # Check if we should trade
        if signal and confidence >= CONFIG['confidence_threshold']:
            print(f"\n🚀 PLACING TRADE!")
            print(f"   Direction: {signal}")
            print(f"   Amount: ${CONFIG['trade_amount']}")
            print(f"   Network: {CONFIG['network'].upper()}")
            
            # Place bet
            success, output = place_bet_with_bankr(signal, CONFIG['trade_amount'])
            
            if success:
                print(f"✅ Trade placed successfully!")
                last_trade_time = time.time()
            else:
                print(f"❌ Trade failed: {output[:200]}")
        else:
            print(f"⏸️  No trade - conditions not met")
        
        # Wait before next check
        time.sleep(CONFIG['check_interval'])


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n🛑 Trader stopped by user")
        sys.exit(0)
    except Exception as e:
        print(f"\n❌ Error: {e}")
        print("Restarting in 30 seconds...")
        time.sleep(30)
        main()  # Restart
