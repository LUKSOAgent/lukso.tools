#!/bin/bash
# Polymarket Bot Watchdog - Auto-restart if frozen

LOG_FILE="/root/.openclaw/workspace/skills/polymarket-fast-loop/rapid_fire_trader.log"
PID_FILE="/tmp/polymarket_bot.pid"
MAX_IDLE_MINUTES=5

# Function to check if bot is running
check_bot_running() {
    pgrep -f "python3 rapid_fire_trader.py" > /dev/null
    return $?
}

# Function to get last log activity
get_last_activity() {
    if [ -f "$LOG_FILE" ]; then
        stat -c %Y "$LOG_FILE"
    else
        echo 0
    fi
}

# Function to restart bot
restart_bot() {
    echo "$(date): Restarting bot..." >> /tmp/bot_watchdog.log
    
    # Kill existing processes
    pkill -9 -f "python3 rapid_fire_trader.py" 2>/dev/null
    sleep 2
    
    # Start new instance
    cd /root/.openclaw/workspace/skills/polymarket-fast-loop
    export SIMMER_API_KEY=$(sops --decrypt /root/.openclaw/workspace/.credentials 2>/dev/null | grep SIMMER_API_KEY | cut -d'=' -f2 | tr -d ' ')
    export WALLET_PRIVATE_KEY=$(sops --decrypt /root/.openclaw/workspace/.credentials 2>/dev/null | grep -A10 'Polymarket Bot Wallet' | grep 'Private Key:' | cut -d':' -f2 | tr -d ' ')
    
    nohup python3 rapid_fire_trader.py >> rapid_fire_trader.log 2>&1 &
    
    sleep 3
    NEW_PID=$(pgrep -f "python3 rapid_fire_trader.py" | head -1)
    echo "$(date): Bot restarted with PID $NEW_PID" >> /tmp/bot_watchdog.log
}

# Main watchdog logic
echo "$(date): Watchdog check started" >> /tmp/bot_watchdog.log

if ! check_bot_running; then
    echo "$(date): Bot not running, restarting..." >> /tmp/bot_watchdog.log
    restart_bot
    exit 0
fi

# Check if log is being updated
LAST_ACTIVITY=$(get_last_activity)
CURRENT_TIME=$(date +%s)
IDLE_MINUTES=$(( (CURRENT_TIME - LAST_ACTIVITY) / 60 ))

if [ $IDLE_MINUTES -gt $MAX_IDLE_MINUTES ]; then
    echo "$(date): Bot idle for $IDLE_MINUTES minutes, restarting..." >> /tmp/bot_watchdog.log
    restart_bot
else
    echo "$(date): Bot healthy (idle $IDLE_MINUTES min)" >> /tmp/bot_watchdog.log
fi
