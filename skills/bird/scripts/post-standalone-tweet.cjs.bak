const { TwitterApi } = require('twitter-api-v2');
const fs = require('fs');

// Use environment variables (exported from cron job after decrypting credentials)
const client = new TwitterApi({
  appKey: process.env.TWITTER_API_KEY,
  appSecret: process.env.TWITTER_API_SECRET,
  accessToken: process.env.TWITTER_ACCESS_TOKEN,
  accessSecret: process.env.TWITTER_ACCESS_SECRET,
});

// Track state
const STATE_DIR = '/root/.openclaw/workspace/.twitter-state';
const LAST_TWEET_FILE = `${STATE_DIR}/last_standalone_tweet.json`;

function loadLastTweet() {
  try {
    return JSON.parse(fs.readFileSync(LAST_TWEET_FILE, 'utf8'));
  } catch {
    return { time: 0, idx: -1 };
  }
}

function saveLastTweet(idx) {
  fs.writeFileSync(LAST_TWEET_FILE, JSON.stringify({ time: Date.now(), idx }));
}

// Standalone tweet topics - informative, not hype
const TWEET_TOPICS = [
  {
    topic: "LSP Standards",
    tweets: [
      "28 LSP standards. Each one solves a specific problem. LSP0 for accounts, LSP6 for permissions, LSP7/8 for tokens, LSP25 for gasless txs, LSP26 for social graphs. Modular > monolithic.",
      "LSP6 KeyManager lets you delegate granular permissions. Want someone to mint tokens but not transfer them? Possible. 16+ permission types, not just 'owner' or 'not owner'.",
      "LSP25 ExecuteRelayCall is underrated. Users can interact with dApps without holding LYX for gas. Relayers handle the fees. This is how you onboard normal people.",
      "LSP26 Follower System = on-chain social graph. Your follows are stored on-chain, not in a database. Portable across any app that supports the standard.",
      "LSP28 The Grid turns your Universal Profile into a customizable dashboard. Mini-apps, widgets, external links — all defined as data, not code."
    ]
  },
  {
    topic: "Universal Profiles",
    tweets: [
      "Universal Profiles are smart contract accounts, not just wallets. They can hold assets, execute batch transactions, delegate permissions, and have recoverable ownership.",
      "Your UP can outlive your private key. Lose your key? Social recovery via LSP11. Try that with a regular wallet.",
      "A Universal Profile can be controlled by multiple keys with different permissions. One key for daily use, another for high-value transactions, another for automated bots.",
      "UPs support LSP1 Universal Receiver. Any contract can notify your profile when transferring assets to it. Your profile can react automatically.",
      "The metadata in your UP (LSP3) isn't just a name and picture. It's a VerifiableURI pointing to JSON-LD. Extensible, verifiable, upgradeable."
    ]
  },
  {
    topic: "Ecosystem",
    tweets: [
      "Over 36,000 Universal Profiles created. 155,000+ validators. 13.8M+ LYXe migrated. Real usage, not just promises. $LYX",
      "Forever Moments lets you post on-chain with LSP8 NFTs. Your moments, your data. AI-generated images + IPFS + LUKSO = actually usable web3 social.",
      "Stakingverse is liquid staking for LYX. sLYX is an LSP7 token — not rebasing like stETH, exchange rate-based. Cleaner for DeFi integrations. $LYX",
      "Universal Swaps is a DEX on LUKSO. Supports LSP7/LSP8 tokens natively. No wrapping hacks needed for NFT swaps.",
      "Envio indexer for LUKSO mainnet is live. Query UP data, LSP26 follows, token transfers — all via GraphQL. Fast, not slow."
    ]
  },
  {
    topic: "Technical",
    tweets: [
      "LUKSO is Ethereum-compatible but not identical. Chain ID 42, native LYX token, same EVM. The difference is the standards layer on top.",
      "LSP7 is for fungible tokens, LSP8 for non-fungible. Both support hooks, metadata, and force transfers (for recovery scenarios). ERC20/721 don't have this flexibility.",
      "Building on LUKSO? @erc725/erc725.js for data fetching, @lukso/up-provider for wallet connections, @lukso/web-components for UI. Tooling exists.",
      "Gas on LUKSO is paid in LYX. But with LSP25 relayers, users can interact without holding any. The relayer pays, gets reimbursed separately.",
      "LSP17 Contract Extension standard lets you add functions to contracts after deployment. Like upgradeability, but more granular."
    ]
  },
  {
    topic: "Philosophy",
    tweets: [
      "LUKSO isn't trying to be the fastest chain. It's trying to be the most usable. Identity-first, standards-based, creator-focused. Different bet than pure scaling.",
      "The physical-digital bridge isn't hype. KidSuper, KARL LAGERFELD, Burnt Pix — real brands building real stuff. Not all speculation.",
      "Web3 has an identity problem. LUKSO's answer: Universal Profiles with on-chain reputation, social graphs, and asset ownership. One profile, any app.",
      "Most chains optimize for transactions per second. LUKSO optimizes for user experience per transaction. Different metric, different outcome.",
      "The LSP standards are designed to work together. LSP0 + LSP6 + LSP25 + LSP26 = an account system that's actually usable by normal people."
    ]
  }
];

async function postStandaloneTweet() {
  console.log('🐦 Standalone Tweet Job Starting...\n');

  const lastTweet = loadLastTweet();
  const now = Date.now();
  
  // Enforce minimum 5.5 hour gap (cron is 6h, but let's be safe)
  const hoursSinceLast = (now - lastTweet.time) / (1000 * 60 * 60);
  if (hoursSinceLast < 5.5) {
    console.log(`⏳ Only ${hoursSinceLast.toFixed(1)}h since last tweet. Minimum 5.5h required.`);
    return;
  }

  // Pick a topic category (cycle through them)
  const topicIdx = (lastTweet.idx + 1) % TWEET_TOPICS.length;
  const topic = TWEET_TOPICS[topicIdx];
  
  // Pick a random tweet from that topic
  const tweetIdx = Math.floor(Math.random() * topic.tweets.length);
  const tweetText = topic.tweets[tweetIdx];

  console.log(`📋 Topic: ${topic.topic}`);
  console.log(`📝 Tweet: ${tweetText}\n`);

  try {
    const tweet = await client.v2.tweet(tweetText);
    console.log(`✅ Tweet posted!`);
    console.log(`🔗 https://x.com/i/status/${tweet.data.id}`);
    
    saveLastTweet(topicIdx);
  } catch (error) {
    console.error('❌ Failed to post tweet:', error.message);
    if (error.code === 403) {
      console.error('   Rate limited? Check Twitter API status.');
    }
    process.exit(1);
  }
}

postStandaloneTweet();
